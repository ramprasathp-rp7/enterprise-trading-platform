# NON-SECRET settings for auth / order / executor (ConfigMap etp-config). Edit, then kubectl apply -k k8s/.build:
# the ConfigMap name carries a hash, so pods restart by themselves when this file changes.
# Anything not set here falls back to Config/application.yml (shared, mounted at /config).
# Secrets (DB_PASSWORD, JWT_SECRET, API keys) are NOT here: see secrets.env.

# ---- database (this deployment uses the existing RDS instance) ----
DB_HOST=database-1.crk0qimgo8yj.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_SCHEMA_TRADE=public
DB_SCHEMA_AUTH=auth
AUTH_POSTGRES_DB=postgres
PGHOST=database-1.crk0qimgo8yj.ap-south-1.rds.amazonaws.com
PGPORT=5432
PGUSER=postgres
PGSSLMODE=verify-full
PGSSLROOTCERT=/config/rds-ca-bundle.pem
SPRING_DATASOURCE_URL=jdbc:postgresql://database-1.crk0qimgo8yj.ap-south-1.rds.amazonaws.com:5432/postgres?currentSchema=public&sslmode=require

# ---- order-service ----
MARKET_DATA_CACHE_PERSISTENCE_ENABLED=true
MARKET_DATA_CACHE_PERSIST_INTERVAL_MS=60000
MARKET_DATA_QUOTE_RESOLVER_MAX_AGE=PT10M

# ---- kafka (the StatefulSet in kafka.yaml) ----
TRADING_EXECUTION_MODE=ASYNC
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# KAFKA_MAX_BLOCK_MS=3000
# ORDERS_TOPIC=orders
# TRADE_EVENTS_TOPIC=trade-events
# MARKET_DATA_TOPIC=market-data
# property placeholder ${EC2_PRIVATE_IP}:${kafka.port} in application.properties
EC2_PRIVATE_IP=kafka
SPRING_KAFKA_CONSUMER_BOOTSTRAP_SERVERS=kafka:29092
SPRING_KAFKA_PRODUCER_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_PRODUCER_MAX_BLOCK_MS=3000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=10000
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=30000
DEAD_LETTER_SEND_TIMEOUT_MS=5000
DEAD_LETTER_NACK_BACKOFF_MS=5000
TRADING_ORDER_REPLAY_INTERVAL_MS=30000
TRADING_ORDER_REPLAY_GRACE_MS=60000
TRADING_ORDER_REPLAY_BATCH_SIZE=100
TRADING_ORDER_REPLAY_PUBLISH_TIMEOUT_MS=5000
TRADING_OUTCOME_REPLAY_INTERVAL_MS=30000
TRADING_OUTCOME_REPLAY_GRACE_MS=60000
TRADING_OUTCOME_REPLAY_BATCH_SIZE=100
TRADING_OUTCOME_REPLAY_PUBLISH_TIMEOUT_MS=5000
POLL_INTERVAL_SECONDS=300
MIN_POLL_INTERVAL_SECONDS=60

# ---- executor-service ----

PGPOOL_MAX=10

# ---- ports (must match the manifests; see the header of each *-service.yaml) ----
AUTH_SERVICE_PORT=3000
ORDER_SERVICE_PORT=8081
EXECUTOR_SERVICE_PORT=8082

# --- auth-service ----
PORT=3000

NODE_ENV=development

# ---- security ----
JWT_ISSUER=auth-service
ACCESS_TOKEN_LIFETIME=900
REFRESH_TOKEN_LIFETIME=604800

# ---- E2E ----
# E2E_BASE_URL=
# E2E_AUTH_API=
# E2E_TRADE_API=
# E2E_USERNAME="test_user_1"
# E2E_PASSWORD="Test@Password1"
# E2E_ACCOUNT_ID="2"
# E2E_SYMBOL="AAPL"

# ---- market data / strategies / notifications ----
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
MARKET_DATA_QUOTE_SOURCE=FAUXNANCE
MARKET_DATA_CACHE_HISTORY_WINDOW=PT24H
MARKET_DATA_CACHE_FILE=/tmp/market-data-cache.json
MARKET_DATA_CACHE_WIPE_ON_STARTUP=false
TRADING_STRATEGY_ENABLED=true
TRADING_STRATEGY_PAUSE_BEFORE_ORDER_MS=0
PRICE_ALERTS_MAX_ACTIVE_PER_ACCOUNT=20
PRICE_ALERTS_MAX_PER_ACCOUNT=100
PRICE_ALERTS_EVALUATE_INTERVAL_MS=30000
TRADING_STRATEGY_EVALUATE_INTERVAL_MS=60000
TRADING_STRATEGY_MAX_ACTIVE_PER_ACCOUNT=10
TRADING_STRATEGY_TRADE_API_URL=http://localhost:8081
SCHEDULER_ACCOUNT_HISTORY_ENABLED=true
SCHEDULER_ACCOUNT_HISTORY_CRON=0 59 23 * * *

PLATFORM_CONFIG_PATH=/config/application.yml
SPRING_CONFIG_IMPORT=optional:file:/config/application.yml

# ---- internal service addresses ----
AUTH_SERVICE_URL=http://auth-service
ORDER_SERVICE_URL=http://order-service

