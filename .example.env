# Database name required by apply.sh; keep in sync with database.name in Config/application.yaml
POSTGRES_DB=trading_system_db

# PostgreSQL libpq environment variables used automatically by psql
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here

DB_PASSWORD=your_password_here

# EC2 / SSH Configuration (for Kafka setup)
EC2_USER=ec2-user
EC2_PRIVATE_IP=your_ec2_private_ip_here
SSH_PORT=22

# Kafka broker host comes from EC2_PRIVATE_IP above; the port lives in Config/application.yaml (kafka.port).
# Override the port with a KAFKA_PORT environment variable if needed.

FAUXNANCE_API_KEY=your_fauxnance_key_here
FAUXNANCE_BASE_URL=https://fauxnance.example.invalid

# Auth Service Configuration
# Service ports and the database name live in Config/application.yaml.
# Setting PORT here would override services.auth.port for the auth service.
JWT_SECRET=your_jwt_secret_here
JWT_ISSUER=auth-service

# Preferences module (Sprint 10): AES-256 key for contact details at rest, base64 of 32 random bytes.
# Generate with: openssl rand -base64 32. Unset means the published dev key (logged as a warning).
PREFERENCES_CONTACT_KEY=your_base64_32_byte_key_here

# Auth Service PostgreSQL Configuration

AUTH_POSTGRES_DB=trading_system_db

# Token Lifetimes (seconds)
ACCESS_TOKEN_LIFETIME=900
REFRESH_TOKEN_LIFETIME=604800

# Database Pool
PGPOOL_MAX=10

# Analytics ETL Configuration
ANALYTICS_DUCKDB_PATH=analytics_store_py.duckdb
ANALYTICS_SCHEMA_PATH=path/to/analytics-schema.sql
ANALYTICS_STAGING_DIR=.staging

NODE_ENV=development


AUTH_IT_USERNAME=Test_Username
AUTH_IT_PASSWORD=Test_Password

# E2E URLs default to Config/application.yaml; uncomment to point tests elsewhere
# E2E_BASE_URL="http://localhost:4200"
# E2E_AUTH_API="http://localhost:3000"
# E2E_TRADE_API="http://localhost:8081"
E2E_USERNAME="test_user_1"
E2E_PASSWORD="Test@Password1"
E2E_ACCOUNT_ID="2"
E2E_SYMBOL="AAPL"

# Quote source for order-service market data cache: FAUXNANCE (quotes API, every 5 min) or KAFKA (market-data topic)
MARKET_DATA_QUOTE_SOURCE=FAUXNANCE
# How long order-service keeps each symbol's quote history (ISO-8601 duration, e.g. PT24H, PT6H)
MARKET_DATA_CACHE_HISTORY_WINDOW=PT24H
# order-service saves its market data cache to this JSON file and reloads it on startup (relative to the service's working directory)
MARKET_DATA_CACHE_FILE=data/market-data-cache.json
# true = delete the saved cache file on startup and start with an empty cache; set back to false to keep quotes across restarts
MARKET_DATA_CACHE_WIPE_ON_STARTUP=false

TRADING_CANDLE_BOOTSTRAP_ENABLED=true
# Automated strategies (order-service): on/off, and a pause before each order to demo a mid-cycle disable
TRADING_STRATEGY_ENABLED=true
TRADING_STRATEGY_PAUSE_BEFORE_ORDER_MS=0
