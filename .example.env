# Database name required by apply.sh
POSTGRES_DB=enterprise_trading_platform

# PostgreSQL libpq environment variables used automatically by psql
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here

DB_PASSWORD=your_password_here

# EC2 / SSH Configuration (for Kafka setup)
EC2_USER=ec2-user
EC2_PRIVATE_IP=your_ec2_private_ip_here
SSH_PORT=22

KAFKA_BOOTSTRAP_SERVERS=your_ec2_private_ip_here:9092

FAUXNANCE_API_KEY=your_fauxnance_key_here
FAUXNANCE_BASE_URL=https://fauxnance.example.invalid

// Auth Service env
# Auth Service Configuration
PORT=3000
JWT_SECRET=your_jwt_secret_here
JWT_ISSUER=auth-service

# Auth Service PostgreSQL Configuration

AUTH_POSTGRES_DB=identity_access_management

# Token Lifetimes (seconds)
ACCESS_TOKEN_LIFETIME=900
REFRESH_TOKEN_LIFETIME=604800

# Database Pool
PGPOOL_MAX=10

# Run migrations on startup
AUTH_RUN_MIGRATIONS=false
