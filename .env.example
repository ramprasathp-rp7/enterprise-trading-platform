# Canonical environment template.
# Copy this file to .env for local development.
# Legacy alias: .example.env (kept in sync for backwards compatibility).

# Database name required by apply.sh; keep in sync with database.name in Config/application.yaml
POSTGRES_DB=trading_system_db

# PostgreSQL libpq environment variables used automatically by psql
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
# Database TLS: disable (local Postgres) | no-verify | require | verify-ca | verify-full (RDS).
# verify-* checks the certificate against Config/rds-ca-bundle.pem; PGSSLROOTCERT overrides the path.
PGSSLMODE=disable
# Java services in Docker: JDBC URL suffix, e.g. ?sslmode=verify-full&sslrootcert=/config/rds-ca-bundle.pem
JDBC_PARAMS=

DB_PASSWORD=your_password_here

# EC2 / SSH Configuration (for Kafka setup)
EC2_USER=ec2-user
EC2_PRIVATE_IP=your_ec2_private_ip_here
SSH_PORT=22

# Kafka broker host comes from EC2_PRIVATE_IP above; the port lives in Config/application.yaml (kafka.port).
# Override the port with a KAFKA_PORT environment variable if needed.

FAUXNANCE_API_KEY=your_fauxnance_key_here
FAUXNANCE_BASE_URL=https://fauxnance.example.invalid

# Auth Service Configuration
# Service ports and the database name live in Config/application.yaml.
# PORT overrides services.auth.port for the auth service; leave it empty to use the shared config.
PORT=
JWT_SECRET=your_jwt_secret_here
JWT_ISSUER=auth-service

# Preferences module (Sprint 10): AES-256 key for contact details at rest, base64 of 32 random bytes.
# Generate with: openssl rand -base64 32. Unset means the published dev key (logged as a warning).
PREFERENCES_CONTACT_KEY=your_base64_32_byte_key_here

# Auth Service PostgreSQL Configuration
AUTH_POSTGRES_DB=trading_system_db

# Token Lifetimes (seconds)
ACCESS_TOKEN_LIFETIME=900
REFRESH_TOKEN_LIFETIME=604800

# Database Pool
PGPOOL_MAX=10

# Analytics ETL Configuration
ANALYTICS_DUCKDB_PATH=Database/duckdb/analytics/analytics_store.duckdb
ANALYTICS_SCHEMA_PATH=Database/duckdb/analytics/analytics-schema.sql
ANALYTICS_STAGING_DIR=.staging

NODE_ENV=development

AUTH_IT_USERNAME=Test_Username
AUTH_IT_PASSWORD=Test_Password
# Account the auth integration test registers its user on (one user per account)
AUTH_IT_ACCOUNT_ID=6

# E2E URLs default to Config/application.yaml when empty; set them to point the tests elsewhere
E2E_BASE_URL=
E2E_AUTH_API=
E2E_TRADE_API=
E2E_USERNAME="test_user_1"
E2E_PASSWORD="Test@Password1"
E2E_ACCOUNT_ID="2"
E2E_SYMBOL="AAPL"

# Quote source for order-service market data cache: FAUXNANCE (quotes API, every 5 min) or KAFKA (market-data topic)
MARKET_DATA_QUOTE_SOURCE=FAUXNANCE
# How long order-service keeps each symbol's quote history (ISO-8601 duration, e.g. PT24H, PT6H)
MARKET_DATA_CACHE_HISTORY_WINDOW=PT24H
# order-service saves its market data cache to this JSON file and reloads it on startup (relative to the service's working directory)
MARKET_DATA_CACHE_FILE=data/market-data-cache.json
# true = delete the saved cache file on startup and start with an empty cache; set back to false to keep quotes across restarts
MARKET_DATA_CACHE_WIPE_ON_STARTUP=false

TRADING_CANDLE_BOOTSTRAP_ENABLED=true
# Automated strategies (order-service): on/off, and a pause before each order to demo a mid-cycle disable
TRADING_STRATEGY_ENABLED=true
TRADING_STRATEGY_PAUSE_BEFORE_ORDER_MS=0

# -----------------------------------------------------------------------------
# Service tuning. Values are the built-in defaults; change them here, not in code.
# -----------------------------------------------------------------------------
# Order execution: ASYNC publishes orders to Kafka for the executor; SYNC settles them in the request
TRADING_EXECUTION_MODE=ASYNC
# Shared config file location (default: Config/application.yaml two folders above each service)
PLATFORM_CONFIG_PATH=
# Database name for psql/libpq tools (same as POSTGRES_DB); apply.sh target override (empty = POSTGRES_DB)
PGDATABASE=trading_system_db
TARGET_DATABASE=
# ETL compatibility aliases, used only when the PG* names are missing
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=

# Kafka producers (order and executor services): fail fast while the broker is down
KAFKA_PRODUCER_MAX_BLOCK_MS=3000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=10000
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=30000
# Executor dead-letter handling
DEAD_LETTER_SEND_TIMEOUT_MS=5000
DEAD_LETTER_NACK_BACKOFF_MS=5000

# Replay of order events that never reached Kafka (order service: ORDER_PLACED / ORDER_CANCELLED)
TRADING_ORDER_REPLAY_INTERVAL_MS=30000
TRADING_ORDER_REPLAY_GRACE_MS=60000
TRADING_ORDER_REPLAY_BATCH_SIZE=100
TRADING_ORDER_REPLAY_PUBLISH_TIMEOUT_MS=5000
# Replay of outcome events (executor: ORDER_FILLED / ORDER_REJECTED)
TRADING_OUTCOME_REPLAY_INTERVAL_MS=30000
TRADING_OUTCOME_REPLAY_GRACE_MS=60000
TRADING_OUTCOME_REPLAY_BATCH_SIZE=100
TRADING_OUTCOME_REPLAY_PUBLISH_TIMEOUT_MS=5000

# Executor market data poller (seconds; never below MIN_POLL_INTERVAL_SECONDS)
POLL_INTERVAL_SECONDS=300
MIN_POLL_INTERVAL_SECONDS=60

# Order service market data cache
MARKET_DATA_CACHE_PERSISTENCE_ENABLED=true
MARKET_DATA_CACHE_PERSIST_INTERVAL_MS=60000
MARKET_DATA_QUOTE_RESOLVER_MAX_AGE=PT10M

# Price alerts
PRICE_ALERTS_MAX_ACTIVE_PER_ACCOUNT=20
PRICE_ALERTS_MAX_PER_ACCOUNT=100
PRICE_ALERTS_EVALUATE_INTERVAL_MS=30000

# Automated strategies (they place orders through the order service's own API)
TRADING_STRATEGY_EVALUATE_INTERVAL_MS=60000
TRADING_STRATEGY_MAX_ACTIVE_PER_ACCOUNT=10
TRADING_STRATEGY_TRADE_API_URL=http://localhost:8081

# End-of-day account history snapshot (cron, UTC)
SCHEDULER_ACCOUNT_HISTORY_ENABLED=true
SCHEDULER_ACCOUNT_HISTORY_CRON=0\ 59\ 23\ *\ *\ *
