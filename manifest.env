
# =============================================================================
# Manifest Environment Configuration — Sprint 3: Trade Database
# =============================================================================

# The trade schema now lives with the order service (the auth schema has its own apply.sh)
APPLY_COMMAND="Database/postgres/order-service/apply.sh"

ACCOUNTS_TABLE="accounts"
ACCOUNT_STATUS_COLUMN="status"
ACCOUNT_STATUS_ACTIVE="ACTIVE"
ACCOUNT_STATUS_SUSPENDED="SUSPENDED"
ACCOUNT_STATUS_CLOSED="CLOSED"

ORDERS_TABLE="orders"
ORDER_IDEMPOTENCY_KEY_COLUMN="idempotency_key"

# =============================================================================
# Manifest Environment Configuration — Sprint 4: Analytics ETL
# =============================================================================

ANALYTICS_PACKAGE_ROOT="ETL"
ANALYTICS_PACKAGE_NAME="trading_analytics_etl"


# Three console scripts: etl-extract (Postgres -> staging), etl-load (staging -> DuckDB), etl-reconcile
ANALYTICS_ENTRY_POINT="etl-load"

ANALYTICS_EXTRACT_FUNCTION="trading_analytics_etl.extract:extract_orders_since"
ANALYTICS_TRANSFORM_FUNCTION="trading_analytics_etl.transform:validate_and_build_fact_row"
ANALYTICS_LOAD_FUNCTION="trading_analytics_etl.pipeline:run_load"

ANALYTICS_MALFORMED_INPUT_TEST_NODE_ID="ETL/tests/test_transform.py::test_invalid_rows_are_rejected_with_reason"

# =============================================================================
# Sprint 5: Domain Engine
# =============================================================================

# The domain engine was folded into the order service (package com.tradingplatform.domain)
DOMAIN_PACKAGE_ROOT="Services/order-service"
DOMAIN_BASE_PACKAGE="com.tradingplatform.domain"


DOMAIN_GROUP_ID="com.tradingplatform"
DOMAIN_ARTIFACT_ID="event-backbone"
DOMAIN_VERSION="1.0.0-SNAPSHOT"


DOMAIN_EXCEPTION_ACCOUNT_NOT_FOUND="com.tradingplatform.domain.exception.AccountNotFoundException"
DOMAIN_EXCEPTION_ACCOUNT_NOT_ACTIVE="com.tradingplatform.domain.exception.AccountNotActiveException"
DOMAIN_EXCEPTION_INSTRUMENT_NOT_FOUND="com.tradingplatform.domain.exception.InstrumentNotFoundException"
DOMAIN_EXCEPTION_INSUFFICIENT_FUNDS="com.tradingplatform.domain.exception.InsufficientFundsException"
DOMAIN_EXCEPTION_INSUFFICIENT_HOLDINGS="com.tradingplatform.domain.exception.InsufficientHoldingsException"
DOMAIN_EXCEPTION_DUPLICATE_ORDER="com.tradingplatform.domain.exception.DuplicateOrderException"

DOMAIN_EXCEPTION_INVALID_ORDER="com.tradingplatform.domain.exception.InvalidOrderException"


# =============================================================================
# Sprint 6: Java API (Services/order-service)
# =============================================================================

BASE_PACKAGE="com.tradingplatform.api"
CONTROLLER_PACKAGE="com.tradingplatform.api.controllers"
MAPPER_PACKAGE="com.tradingplatform.api.mappers"

# =============================================================================
# Sprint 7: Event Backbone (Kafka)
# =============================================================================

# Kafka Configuration
KAFKA_CLUSTER_ID="4L6g3nShT-eMCtK--X86sw"
KAFKA_CONTAINER_NAME="kafka"
KAFKA_DOCKER_IMAGE="apache/kafka:latest"
KAFKA_BOOTSTRAP_SERVER="localhost:9092"
KAFKA_REPLICATION_FACTOR=1

# Topic Configuration (in milliseconds)
# orders: 7 days
KAFKA_ORDERS_PARTITIONS=3
KAFKA_ORDERS_RETENTION_MS=604800000

# trade-events: 30 days
KAFKA_TRADE_EVENTS_PARTITIONS=3
KAFKA_TRADE_EVENTS_RETENTION_MS=2592000000

# market-data: 1 day (high volume, low retention)
KAFKA_MARKET_DATA_PARTITIONS=6
KAFKA_MARKET_DATA_RETENTION_MS=86400000

# Dead-letter topics: 1 day
KAFKA_DLT_RETENTION_MS=86400000