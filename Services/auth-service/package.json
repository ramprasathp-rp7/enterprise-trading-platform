{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Sprint 8: Authentication service for the Enterprise Trading Platform",
  "main": "dist/main.js",
  "author": "Team",
  "license": "ISC",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "node --env-file-if-exists=../../.env -r ts-node/register src/main.ts",
    "test": "node --env-file-if-exists=../../.env ./node_modules/jest/bin/jest.js --passWithNoTests",
    "test:watch": "node --env-file-if-exists=../../.env ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --env-file-if-exists=../../.env ./node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.43",
    "@types/passport-jwt": "^3.0.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
