{
  "name": "sprint-09-trading-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "generate:trade": "openapi-generator-cli generate -c openapi/trade-api-config.json",
    "generate:auth": "openapi-generator-cli generate -c openapi/auth-api-config.json",
    "generate:transactions": "openapi-generator-cli generate -c openapi/transactions-api-config.json",
    "generate:admin": "openapi-generator-cli generate -c openapi/admin-api-config.json",
    "generate:watchlist": "openapi-generator-cli generate -c openapi/watchlist-api-config.json",
    "generate:portfolio": "openapi-generator-cli generate -c openapi/portfolio-api-config.json",
    "generate:preferences": "openapi-generator-cli generate -c openapi/preferences-api-config.json",
    "generate": "npm run generate:auth && npm run generate:trade && npm run generate:transactions && npm run generate:admin && npm run generate:watchlist && npm run generate:portfolio && npm run generate:preferences"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@ngrx/signals": "^21.0.0",
    "chart.js": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.2.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "piscina": "^5.3.2",
    "basic-ftp": "^6.2.1"
  }
}
